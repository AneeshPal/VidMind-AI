
{
    "manifest_version": 3,
    "name": "VidMind - YouTube AI Assistant",
    "version": "1.0.0",
    "description": "Ask questions about YouTube videos using AI.",
  
    "permissions": [
      "sidePanel"
    ],
  
    "background": {
      "service_worker": "service-worker.js"
    },
  
    "action": {
      "default_title": "Open VidMind"
    },
  
    "side_panel": {
      "default_path": "index.html"
    }
  }
  